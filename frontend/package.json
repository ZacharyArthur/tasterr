{
	"name": "frontend",
	"private": true,
	"version": "1.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --no-file-parallelism",
		"e2e": "playwright test",
		"preview": "vite preview"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@playwright/test": "1.62.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.13.0",
		"typescript": "~7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"@redocly/openapi-core@1.34.17": {
			"js-yaml": "4.3.0"
		}
	}
