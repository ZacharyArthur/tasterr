{
	"name": "frontend",
	"private": true,
	"version": "2.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run --no-file-parallelism",
		"e2e": "playwright test",
		"preview": "vite preview"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-query": "^5.106.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"tailwindcss": "^4.3.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@playwright/test": "1.64.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^31.0.0",
		"openapi-typescript": "^7.13.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"@redocly/openapi-core@1.34.17": {
			"js-yaml": "4.3.2"
		}
