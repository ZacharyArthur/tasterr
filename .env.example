# Tasterr configuration — copy to .env and fill in real values.
# Placeholders only in this file; never commit a real .env.

# Compose-only overrides (defaults shown).
#TASTERR_IMAGE=tasterr:latest
#TASTERR_HTTP_PORT=8000
#TASTERR_ENV_FILE=.env

# Optional: only set when using docker-compose.seerr-network.yml to join Seerr's
# existing network on this same Docker host. Remote/LAN Seerr needs no network value.
#TASTERR_MEDIA_NETWORK=media

# TMDB API key (v3 auth): https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# How Tasterr reaches Seerr server-side (compose service name or LAN address).
# Never exposed to browsers.
SEERR_INTERNAL_URL=http://seerr:5055

# Public URL of your Seerr instance, used for client-visible redirect links.
SEERR_EXTERNAL_URL=https://requests.example.com

# Seerr API key: Seerr → Settings → General
SEERR_API_KEY=your-seerr-api-key

# Random secret; encrypts stored Plex tokens at rest.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TASTERR_SECRET_KEY=generate-a-random-secret

# SQLite location. The container default is /data/tasterr.db (named volume);
# only override for non-container setups.
#DATABASE_PATH=data/tasterr.db

# Bind address/port (container default shown).
#TASTERR_HOST=0.0.0.0
#TASTERR_PORT=8000

# Direct proxy peer IPs/CIDRs whose X-Forwarded-* headers Tasterr may trust.
# Keep this narrow; never use `*`. Loopback-only is the safe default.
#TASTERR_FORWARDED_ALLOW_IPS=127.0.0.1

# Where the built SPA lives (container default shown; rarely overridden).
#STATIC_DIR=/app/static
