# Tasterr configuration — copy to .env and fill in real values.
# Placeholders only in this file; never commit a real .env.

# Compose-only overrides. Source-build default shown; published deployments should
# leave TASTERR_IMAGE unset to use the release pinned in compose.example.yaml.
# Do not tag a local source build with a published release tag.
#TASTERR_IMAGE=tasterr:latest
# Loopback is the safe default. Set 8000 (or a specific LAN IP:port) only when
# household clients intentionally connect directly and the host firewall allows it.
#TASTERR_HTTP_PORT=127.0.0.1:8000
#TASTERR_ENV_FILE=.env

# Optional: only set when using docker-compose.seerr-network.yml to join Seerr's
# existing network on this same Docker host. Remote/LAN Seerr needs no network value.
#TASTERR_MEDIA_NETWORK=media

# TMDB API key (v3 auth): https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Optional Plex server machine identifier; enables Plex sign-in without Seerr
# and pins history/Continue Watching. Plex Web → Settings → General, or /identity.
# Requires a release after 2.3.1; ignored by 2.3.1 (no membership restriction).
#PLEX_SERVER_ID=your-server-machine-identifier

# Optional Jellyfin integration; both URL and API key are required.
# All JELLYFIN_* settings require a release after 2.3.1; ignored by 2.3.1.
# Server-side only. Jellyfin Dashboard → Advanced → API Keys → add a key.
#JELLYFIN_INTERNAL_URL=http://jellyfin:8096
#JELLYFIN_API_KEY=your-jellyfin-api-key
# Passwordless accounts are refused unless explicitly enabled.
#JELLYFIN_ALLOW_EMPTY_PASSWORD=false

# Optional Trakt watch history, never a sign-in method. Register your own app
# at https://developer.trakt.tv/apps with Redirect URI http://localhost.
# Choose Development and add household testers; see docs/CONFIGURATION.md#trakt-watch-history.
# Newer apps issue no secret; requires a post-2.3.1 release.
#TRAKT_CLIENT_ID=your-trakt-client-id
#TRAKT_CLIENT_SECRET=your-trakt-client-secret

# Seerr is optional with Plex or Jellyfin configured; omit its three values
# for deployments without Seerr. Enable at least one sign-in provider.
# The pinned 2.3.1 release requires Seerr; direct Plex/Jellyfin needs a later release.
# How Tasterr reaches Seerr server-side (compose service name or LAN address).
# Never exposed to browsers.
SEERR_INTERNAL_URL=http://seerr:5055

# Public URL of your Seerr instance, used for client-visible redirect links.
SEERR_EXTERNAL_URL=https://requests.example.com

# Seerr API key: Seerr → Settings → General
SEERR_API_KEY=your-seerr-api-key

# Random secret; encrypts linked Plex tokens, Seerr cookies, and Trakt tokens.
# Generate one using the Docker command in docs/CONFIGURATION.md.
# Keep secret values here, never inline in Compose; single-quote literal $ values.
TASTERR_SECRET_KEY=generate-a-random-secret

# Maximum unauthenticated Plex identity probes per server (3-12; default 6).
# Raising this increases bounded connection-discovery traffic.
#TASTERR_PLEX_MAX_CONNECTION_PROBES=6

# First Plex/Jellyfin history sync lookback in days (1-3650; default 365).
# Later syncs and caps are unchanged. Restart and use Reset taste profile to re-import.
# Requires a release after 2.3.1; ignored by 2.3.1.
#TASTERR_WATCH_HISTORY_DAYS=365

# Optional household discovery overrides. Unset means use admin preferences.
# Explicit false or [] overrides the saved value; matching controls are locked.
#TASTERR_HIDE_LIBRARY_ITEMS=true
# Watched hiding defaults on; false restores watched titles to discovery.
# Requires a release after 2.3.1; ignored by 2.3.1.
#TASTERR_HIDE_WATCHED_ITEMS=false
#TASTERR_EXCLUDED_SERVICE_IDS=[8]

# Optional sign-in allowlist; JSON array of 1-3 unique plex/jellyfin/seerr names.
# Locks Settings; configured integrations still support linking/history/requests.
# Requires a release after 2.3.1; ignored by 2.3.1.
# To recover a lockout, include an existing linked method and restart; unset to edit.
#TASTERR_SIGN_IN_METHODS=["jellyfin"]

# SQLite location. The container default is /data/tasterr.db (named volume);
# keep it on a persistent volume if overriding.
#DATABASE_PATH=/data/tasterr.db

# Bind address/port (container default shown).
#TASTERR_HOST=0.0.0.0
#TASTERR_PORT=8000

# Direct proxy peer IPs/CIDRs whose X-Forwarded-* headers Tasterr may trust.
# Keep this narrow; never use `*`. Loopback-only is the safe default.
#TASTERR_FORWARDED_ALLOW_IPS=127.0.0.1

# Where the built SPA lives (container default shown; rarely overridden).
#STATIC_DIR=/app/static
